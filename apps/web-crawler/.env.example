# Example configuration for the web crawler
# Copy this file to .env and adjust as needed

# REQUIRED: the url to crawl
START_URL=https://crawlme.monzo.com/

# Maximum crawl depth (if set to 0 it'll crawl just the start URL)
MAX_DEPTH=5

# Number of worker goroutines
WORKERS=4

# HTTP client timeout
HTTP_TIMEOUT=10s

# Task queue channel buffer size
TASK_QUEUE_BUFFER=100